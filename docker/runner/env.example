# Copy this file's contents into the stack's "Environment variables" in
# the Portainer UI when creating/editing the vv-runner stack - do NOT
# commit a real token into this file or into docker-compose.yml.
#
# GITHUB_RUNNER_PAT: a fine-grained personal access token scoped to ONLY
# gregbtm/VoucherVault, with the "Administration: Read and write"
# repository permission (that's the specific permission runner
# registration needs) and nothing else. See docs/SELF_HOSTED_RUNNER.md
# for the exact steps to generate one.
GITHUB_RUNNER_PAT=
